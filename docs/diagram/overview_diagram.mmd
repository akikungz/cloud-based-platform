flowchart LR
 subgraph subGraph0["Human Actors"]
        U[/"User<br>(Student/Staff)"/]
        A[/"System Administrator"/]
  end
 subgraph subGraph1["External Systems"]
        PVE[("Proxmox VE API")]
        G[("Google OAuth")]
  end
 subgraph subGraph2["Monitoring & Observability"]
        M[("Monitoring Stack<br>Grafana, Prometheus, Loki")]
  end
    U -- "1. Manages VMs &amp;<br>Submits Requests (HTTPS)" --> C(("Cloud-Based Platform"))
    C -- "2. Displays UI &amp;<br>VM Status (HTML/JSON)" --> U
    C -- "3. Authentication Requests" --> G
    G -- "4. Auth Tokens &amp;<br>User Profile" --> C
    C -- "5. VM Operation Commands<br>(Create, Start, Stop)" --> PVE
    PVE -- "6. VM Status &amp;<br>Operation Results" --> C
    C -- "7. Emits Metrics, Logs, Traces" --> M
    A -- "8. Monitors System Health &amp;<br>Views Dashboards" --> M
     U:::actor
