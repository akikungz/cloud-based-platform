# Database Configuration
DB_USER=user
DB_PASSWORD=password
DB_NAME=postgres
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}

# RabbitMQ Configuration
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:${RABBITMQ_PORT}

# Proxmox VE Configuration (for Yuzu)
PVE_API_URL=https://pve.example.com:8006/api2/json
PVE_API_TOKEN=your-api-token-here
PVE_API_TOKEN_NAME=your-token-name
PVE_API_TOKEN_USER=user@pam
PVE_NODES=node1,node2,node3

# Momoi (API Service) Configuration
MOMOI_PORT=3001
API_URL=http://localhost:3001
BETTER_AUTH_SECRET=your-secret-key-change-in-production
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# Midori (Frontend) Configuration
MIDORI_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
MOMOI_API_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:3000

# Authentication (BetterAuth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Monitoring Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin