{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "baseUrl": "./",
    "paths": {
      "@momoi/*": ["./src/*"]
    },
    "types": ["bun-types", "@types/amqplib"],
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": false,
    "noErrorTruncation": true
  },
  "exclude": [
    "../../packages/database/generated/prismabox/**"
  ]
}
