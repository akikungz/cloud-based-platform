# =============================================================================
# .dockerignore for apps/momoi (Backend API - Elysia/Bun)
# =============================================================================

# Node.js dependencies (will be installed fresh in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Coverage and testing
coverage/
.nyc_output/
*.lcov

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
.tmp/
.temp/
tmp/
temp/

# Cache directories
.cache/
.parcel-cache/

# Development tools
.eslintcache
.stylelintcache

# Build artifacts
dist/
build/

# Documentation
README.md
*.md

# Git
.git/
.gitignore

# Docker files
Dockerfile*
docker-compose*
.dockerignore

# Testing
__tests__/
*.test.*
*.spec.*
jest.config.*
vitest.config.*

# Development configs
.eslintrc*
.prettierrc*
.stylelintrc*
.editorconfig
.nvmrc

# Package manager files
package-lock.json
yarn.lock
bun.lockb

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Optional npm cache
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Bun specific
.bun/

# Database files (use external database)
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup
*.old

# Security files
*.pem
*.key
*.crt
*.p12
*.pfx

# SSH keys
id_rsa*
id_dsa*
id_ed25519*
known_hosts
