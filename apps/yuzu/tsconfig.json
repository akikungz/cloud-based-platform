{
	"compilerOptions": {
		"target": "ES2021",
		"skipLibCheck": true,
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@yuzu/*": ["./src/*"]
		}
	},
}
