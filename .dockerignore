# =============================================================================
# .dockerignore - Docker build context exclusions
# =============================================================================
# This file excludes files and directories from the Docker build context
# to reduce build time and image size, and improve security.

# =============================================================================
# From .gitignore (Node.js/TypeScript project exclusions)
# =============================================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# =============================================================================
# Docker-specific exclusions
# =============================================================================

# Docker files themselves (avoid recursive copying)
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
.dockerignore

# Git and version control
.git
.gitignore
.gitattributes
.github/

# Documentation and README files
README.md
readme.md
*.md
docs/
documentation/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing and CI/CD
tests/
test/
__tests__/
*.test.*
*.spec.*
coverage/
.nyc_output/
jest.config.*
vitest.config.*
cypress/
cypress.json
playwright.config.*

# Development tools and configs
.eslintrc*
.prettierrc*
.stylelintrc*
tsconfig.tsbuildinfo
.editorconfig
.nvmrc

# Temporary and cache directories
tmp/
temp/
.tmp/
.temp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================================================
# Project-specific exclusions
# =============================================================================

# Development environment files
.env.local
.env.development
.env.test
.env.production

# Build artifacts that shouldn't be in containers
build/
dist/
out/

# Database files (use volumes instead)
*.db
*.sqlite
*.sqlite3

# Log files
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# =============================================================================
# Security-related exclusions
# =============================================================================

# Private keys and certificates
*.pem
*.key
*.crt
*.p12
*.pfx

# SSH keys
id_rsa*
id_dsa*
id_ed25519*
known_hosts

# Backup files
*.bak
*.backup
*.old

# =============================================================================
# Performance optimizations
# =============================================================================

# Large media files (should be served from CDN or volumes)
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.webm
*.mkv
*.mp3
*.wav
*.flac
*.aac
*.ogg

# Large binary files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# =============================================================================
# Monitoring and observability (if not needed in container)
# =============================================================================

# Jaeger, Prometheus, Grafana configs (if using external services)
config/services/

# =============================================================================
# Development-only packages and tools
# =============================================================================

# Development dependencies (will be installed fresh in container)
package-lock.json
yarn.lock
bun.lockb

# Local development scripts
scripts/dev/
scripts/local/

# Prisma
packages/database/generated
